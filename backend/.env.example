# AI Code Analysis Platform - Environment Variables
# Copy this file to .env and fill in the values

# LLM Configuration (OpenAI-compatible API)
LLM_BASE_URL=https://your-api-endpoint/v1
LLM_API_KEY=your-api-key
LLM_MODEL=xopqwen36v35b
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

DATABASE_URL=sqlite+aiosqlite:///./code_analysis.db
WORKSPACE_DIR=workspace
DEBUG=true

# 多模型池配置 (JSON数组，每个模型可独立配置 base_url/api_key)
MODEL_POOL_CONFIG=[{"model_id":"xopqwen36v35b","max_concurrency":3}]
MODEL_DEFAULT_BASE_URL=https://your-api-endpoint/v1
MODEL_DEFAULT_API_KEY=your-api-key
MODEL_ROUTER_STRATEGY=least_busy
